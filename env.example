# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=places_db
POSTGRES_USER=places_user
POSTGRES_PASSWORD=places_password

# Google Places API Configuration
GOOGLE_PLACES_API_KEY=AIzaSyDgFavAboB7Eh-F7VcHWJWkXCBFYSHzsH4

# Search Parameters
SEARCH_REGION=Byron Bay, NSW, Australia
SEARCH_POSTAL_CODE=2481
SEARCH_CATEGORY=Women's Clothing Store

# Enrichment Settings
# Выбор библиотеки для браузерной автоматизации
# Возможные значения: "playwright", "pyppeteer", "auto"
# "auto" - автоматический выбор на основе доступности библиотек (по умолчанию)
ENRICHMENT_BROWSER_LIBRARY=pyppeteer

# Headless режим браузера (true/false)
ENRICHMENT_HEADLESS=true

# Таймаут загрузки страницы в миллисекундах
ENRICHMENT_TIMEOUT=30000

# Pipeline Parallelism Settings
# Максимальное количество параллельных задач обогащения данных
PIPELINE_MAX_CONCURRENT_ENRICHMENT=5

# Максимальное количество параллельных записей в базу данных
PIPELINE_MAX_CONCURRENT_DB_WRITES=10

